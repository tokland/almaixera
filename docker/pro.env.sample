# Settings for a server container. Copy to docker/pro.env and fill in.
#
#   cp docker/pro.env.sample docker/pro.env
#   chmod 600 docker/pro.env
#
# docker/pro.env is gitignored AND in .dockerignore, so it never reaches the
# repository or the image. docker/start.sh loads it automatically when it is
# there; docker/deploy-pro.sh copies it to the production host (mode 600), so
# the password stays out of your shell history and out of the ssh command
# line, and a manual restart on the server keeps the same configuration.
#
# Values are literal: this file is parsed as plain KEY=value, never sourced,
# so SYNC_SCHEDULE=0 23 * * 2 works without quoting. Surrounding quotes are
# allowed and stripped. Command line flags override anything set here.

# Almaixera credentials the weekly provider sync authenticates with. Without
# SYNC_PASSWORD no cron job is scheduled at all.
SYNC_USER=admin
SYNC_PASSWORD=change-me

# When it runs. Default is Tuesday at 23:00, Europe/Madrid.
SYNC_SCHEDULE=0 23 * * 2

# Extra flags for providers/ecoplaza/sync.sh. Set to --dry-run to make the
# weekly job report what it would do without writing anything.
SYNC_ARGS=

# Container restart policy: unless-stopped brings the site and its cron back
# after a reboot.
RESTART=unless-stopped

# Optional email report of every weekly run, sent at the end of
# providers/ecoplaza/cron-sync.sh by notify_email.py. Leave SMTP_HOST empty to
# keep the job silent. For Gmail the password is an app password (Google
# Account > Security > 2-Step Verification > App passwords), not the account
# one; with SMTP_TO empty the report goes to SMTP_USER.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=me@gmail.com
SMTP_PASSWORD=
SMTP_TO=
