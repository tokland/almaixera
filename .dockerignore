*.py[cod]
env/
virtualenv*
.python-version
*.code-workspace

# Big local fixtures, not needed to run the app.
almaixera*.json
natureco/

# Scrape output: regenerated inside the container on every sync.
providers/*/products.json
providers/*/skipped.csv
